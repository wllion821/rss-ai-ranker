---
interface Props {
  score: number;
}

const { score } = Astro.props;

const getColor = (s: number) => {
  if (s >= 90) return 'bg-red-100 text-red-700 border-red-200';
  if (s >= 80) return 'bg-orange-100 text-orange-700 border-orange-200';
  if (s >= 70) return 'bg-blue-100 text-blue-700 border-blue-200';
  return 'bg-gray-100 text-gray-700 border-gray-200';
};
---

<div class={`inline-flex items-center justify-center w-12 h-12 rounded-full border-2 font-bold text-lg ${getColor(score)}`}>
  {score}
</div>
