---
interface Props {
  score: number;
}

const { score } = Astro.props;

const getBadgeStyle = (s: number) => {
  if (s > 80) {
    return 'background:#ecfdf5;color:#22c55e;';
  }
  if (s >= 60) {
    return 'background:#fef3c7;color:#eab308;';
  }
  return 'background:#f3f4f6;color:#9ca3af;';
};

const badgeStyle = getBadgeStyle(score);
---

<div style={`display:inline-flex;align-items:center;justify-content:center;width:72px;height:72px;border-radius:9999px;border:2px solid rgba(148,163,184,0.32);font-weight:700;font-size:1.5rem;${badgeStyle}`}>
  {score}
</div>
