---
import ScoreBadge from './ScoreBadge.astro';

const { article } = Astro.props;

const tags = Array.isArray(article?.tags) ? article.tags : [];
const score = article?.recommendationScore || 0;
const comment = article?.comment || '';
const source = article?.source || '';
const title = article?.title || 'No Title';
const link = article?.link || '#';
const rawSummary = article?.summary || '';

const cleanSummary = (summary: string) => {
  // 去掉 URL
  summary = summary.replace(/https?:\/\/[^\s]+/g, '');
  // 去掉元数据文字
  summary = summary.replace(/Article URL:/gi, '');
  summary = summary.replace(/Comments URL:/gi, '');
  summary = summary.replace(/Points:/gi, '');
  summary = summary.replace(/# Comments:/gi, '');
  // 截断到 200 字符
  if (summary.length > 200) {
    summary = summary.substring(0, 200) + '...';
  }
  return summary.trim();
};

const summary = cleanSummary(rawSummary);

let formattedDate = '';
try {
  if (article?.publishedAt) {
    formattedDate = new Date(article.publishedAt).toLocaleDateString('zh-CN', {
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }
} catch (e) {
  formattedDate = '';
}
---

<div class="bg-white text-slate-900 rounded-2xl shadow-xl border border-slate-200 p-6 hover:shadow-2xl transition-shadow">
  <div class="flex flex-col md:flex-row justify-between items-start gap-4">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-medium px-2 py-1 bg-indigo-50 text-indigo-600 rounded-full">{source}</span>
        <span class="text-xs text-gray-400">{formattedDate}</span>
      </div>
      <h3 class="text-xl font-bold mb-2">
        <a href={link} target="_blank" rel="noopener noreferrer" class="text-slate-950 hover:text-indigo-600 transition">
          {title}
        </a>
      </h3>
      <p class="text-slate-700 text-sm mb-4">{summary}</p>
    </div>
    <ScoreBadge score={score} />
  </div>

  {comment && (
    <div class="bg-slate-50 rounded-lg p-4 mb-4">
      <p class="text-sm font-medium text-slate-900 mb-1">AI 点评：</p>
      <p class="text-sm text-slate-700 italic">"{comment}"</p>
    </div>
  )}

  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag: string) => (
        <span class="text-xs text-slate-700 bg-slate-100 px-2 py-1 rounded-full">#{tag}</span>
      ))}
    </div>
  )}
</div>
