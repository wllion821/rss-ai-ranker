---
import ScoreBadge from './ScoreBadge.astro';

const { article } = Astro.props;

const tags = Array.isArray(article?.tags) ? article.tags : [];
const score = typeof article?.recommendationScore === 'number' ? article.recommendationScore : 0;
const comment = typeof article?.comment === 'string' ? article.comment : '';
const source = typeof article?.source === 'string' ? article.source : '';
const title = typeof article?.title === 'string' ? article.title : 'No Title';
const link = typeof article?.link === 'string' ? article.link : '#';
const rawSummary = typeof article?.summary === 'string' ? article.summary : '';

const cleanSummary = (summary: string) => {
  summary = summary.replace(/https?:\/\/[^\s]+/gi, '');
  summary = summary.replace(/Article URL:\s*[^\s]+/gi, '');
  summary = summary.replace(/Comments URL:\s*[^\s]+/gi, '');
  summary = summary.replace(/Points:\s*\d+/gi, '');
  summary = summary.replace(/# Comments:\s*\d+/gi, '');
  summary = summary.replace(/\n+/g, ' ');
  summary = summary.replace(/\s{2,}/g, ' ');
  summary = summary.trim();
  if (summary.length > 200) {
    return summary.substring(0, 200) + '...';
  }
  return summary;
};

const summary = cleanSummary(rawSummary);

let formattedDate = '';
try {
  if (article?.publishedAt) {
    formattedDate = new Date(article.publishedAt).toLocaleDateString('zh-CN', {
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  }
} catch (e) {
  formattedDate = '';
}
---

<div style="background:#ffffff;color:#0f172a;border-radius:12px;box-shadow:0 16px 40px rgba(15,23,42,0.12);border:1px solid rgba(148,163,184,0.16);padding:20px;margin-bottom:16px;">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;">
    <div style="flex:1;min-width:0;">
      <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;align-items:center;">
        <span style="font-size:12px;color:#6b7280;background:rgba(148,163,184,0.12);padding:4px 8px;border-radius:9999px;">{source}</span>
        <span style="font-size:12px;color:#6b7280;">{formattedDate}</span>
      </div>
      <h3 style="margin:0 0 12px;font-size:1.25rem;line-height:1.3;">
        <a href={link} target="_blank" rel="noopener noreferrer" style="color:#1d4ed8;text-decoration:none;cursor:pointer;">
          {title}
        </a>
      </h3>
      <p style="margin:0 0 0.75rem;font-size:0.95rem;line-height:1.6;color:#475569;">{summary}</p>
    </div>
    <ScoreBadge score={score} />
  </div>

  {comment && (
    <div style="background:#f1f5f9;border-radius:12px;padding:16px;margin-top:16px;color:#334155;">
      <p style="margin:0 0 8px;font-size:0.95rem;font-weight:600;">AI 点评：</p>
      <p style="margin:0;font-size:0.95rem;line-height:1.7;font-style:italic;">"{comment}"</p>
    </div>
  )}

  {tags.length > 0 && (
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;">
      {tags.map((tag: string) => (
        <span style="font-size:0.78rem;color:#475569;background:#e2e8f0;padding:6px 10px;border-radius:9999px;">#{tag}</span>
      ))}
    </div>
  )}
</div>
