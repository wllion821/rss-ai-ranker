---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

let articles: any[] = [];
let dailySummary = '';
let dateLabel = '今日';

try {
  const dataDir = path.join(process.cwd(), 'data');
  if (fs.existsSync(dataDir)) {
    const files = fs.readdirSync(dataDir)
      .filter((f: string) => f.startsWith('articles-') && f.endsWith('.json'))
      .sort()
      .reverse();
    if (files.length > 0) {
      const raw = fs.readFileSync(path.join(dataDir, files[0]), 'utf-8');
      const parsed = JSON.parse(raw);
      if (parsed.articles && Array.isArray(parsed.articles)) {
        articles = parsed.articles;
        dailySummary = parsed.dailySummary || '';
      } else if (Array.isArray(parsed)) {
        articles = parsed; // 兼容旧格式
      }
      dateLabel = files[0].replace('articles-', '').replace('.json', '');
    }
  }
} catch (e) {
  articles = [];
}

const validArticles = articles
  .filter((a: any) => a && typeof a === 'object');

const totalArticles = validArticles.length;

const recommendedArticles = validArticles
  .filter((a: any) => (a.recommendationScore || 0) >= 70)
  .sort((a: any, b: any) => (b.recommendationScore || 0) - (a.recommendationScore || 0));

const averageScore = recommendedArticles.length > 0
  ? Number((recommendedArticles.reduce((sum: number, a: any) => sum + (a.recommendationScore || 0), 0) / recommendedArticles.length).toFixed(1))
  : 0;

const highScoreCount = recommendedArticles.filter((a: any) => (a.recommendationScore || 0) >= 90).length;

const activeSourceCount = new Set(validArticles
  .map((a: any) => (typeof a?.source === 'string' ? a.source : ''))
  .filter(Boolean)).size;

const tagCounts = new Map<string, number>();
validArticles.forEach((article: any) => {
  const tags = Array.isArray(article?.tags) ? article.tags : [];
  tags.forEach((tag: any) => {
    if (typeof tag !== 'string' || !tag.trim()) return;
    const key = tag.trim();
    tagCounts.set(key, (tagCounts.get(key) || 0) + 1);
  });
});

const popularTags = Array.from(tagCounts.entries())
  .filter(([, count]) => count >= 3)
  .sort((a, b) => b[1] - a[1])
  .map(([tag]) => tag);

const sourceFile = path.join(process.cwd(), 'data', 'sources.json');
let sourceCount = 0;
try {
  const sourceRaw = fs.readFileSync(sourceFile, 'utf-8');
  const sourceParsed = JSON.parse(sourceRaw);
  if (Array.isArray(sourceParsed)) {
    sourceCount = sourceParsed.length;
  }
} catch (e) {
  sourceCount = 0;
}

const averageScoreColor = averageScore >= 80 ? '#22c55e' : '#eab308';
const recommendedCount = recommendedArticles.length;
---

<BaseLayout title="RSS AI 评分网站" footerText={`Powered by GitHub Actions + Gemini AI | ${sourceCount} 个 RSS 源 | 数据日期 ${dateLabel}`}>
  <style>
    #page-title { margin: 0 0 8px; font-size: 2rem; color: #ffffff; }
    #stats-panel { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:16px; }
    [data-stat-card] { background:#1e293b; border-radius:8px; padding:12px; }
    [data-stat-number] { font-size:24px; font-weight:700; color:#ffffff; margin:0 0 4px; }
    [data-stat-label] { font-size:12px; color:#94a3b8; margin:0; }
    #search-box { width:100%; border-radius:8px; background:#1e293b; color:#ffffff; border:1px solid #334155; padding:10px 12px 10px 30px; font-size:0.95rem; margin-bottom:16px; }
    #search-box:focus { outline:none; border-color:#22c55e; }
    #search-wrapper { position:relative; margin-bottom:16px; }
    #search-icon { position:absolute; left:10px; top:50%; transform:translateY(-50%); pointer-events:none; }
    @media (max-width: 640px) {
      #page-title { font-size: 1.4rem; }
      #stats-panel { grid-template-columns:repeat(2,1fr); }
    }
  </style>
  <h1 id="page-title">📡 今日科技速递 ({dateLabel})</h1>
  <p style="margin:0 0 16px;color:#cbd5e1;">共 {recommendedCount} 篇推荐（总计 {totalArticles} 篇文章中筛选）</p>

  {dailySummary && (
    <div style="background:#1e293b;border-radius:12px;padding:16px;margin-bottom:16px;border-left:4px solid #22d3ee;">
      <h3 style="margin:0 0 8px;color:#22d3ee;font-size:1.1rem;">🤖 AI 今日摘要</h3>
      <div id="daily-summary-container" style="overflow:hidden;max-height:3.2em;transition:max-height 0.3s ease;position:relative;">
        <p id="daily-summary-text" style="margin:0;color:#e2e8f0;line-height:1.6;">{dailySummary}</p>
      </div>
      <div style="text-align:right;margin-top:8px;">
        <span id="daily-summary-toggle" style="display:inline-block;color:#22d3ee;font-size:12px;cursor:pointer;user-select:none;">展开全文 ▼</span>
      </div>
    </div>
  )}

  <div id="stats-panel">
    <div data-stat-card style="background:#1e293b;border-radius:8px;padding:12px;">
      <p data-stat-number style="font-size:24px;font-weight:700;color:#ffffff;margin:0 0 4px;">{recommendedCount}</p>
      <p data-stat-label style="font-size:12px;color:#94a3b8;margin:0;">今日新增</p>
    </div>
    <div data-stat-card style="background:#1e293b;border-radius:8px;padding:12px;">
      <p data-stat-number style={`font-size:24px;font-weight:700;margin:0 0 4px;color:${averageScoreColor};`}>{averageScore}</p>
      <p data-stat-label style="font-size:12px;color:#94a3b8;margin:0;">平均分</p>
    </div>
    <div data-stat-card style="background:#1e293b;border-radius:8px;padding:12px;">
      <p data-stat-number style="font-size:24px;font-weight:700;color:#22c55e;margin:0 0 4px;">{highScoreCount}</p>
      <p data-stat-label style="font-size:12px;color:#94a3b8;margin:0;">高分文章</p>
    </div>
    <div data-stat-card style="background:#1e293b;border-radius:8px;padding:12px;">
      <p data-stat-number style="font-size:24px;font-weight:700;color:#ffffff;margin:0 0 4px;">{activeSourceCount}</p>
      <p data-stat-label style="font-size:12px;color:#94a3b8;margin:0;">活跃源</p>
    </div>
  </div>

  {highScoreCount > 0 && (
    <a href="/rss-ai-ranker/highlights/" style="text-decoration:none;display:block;margin-bottom:16px;">
      <div style="background:#1e293b;border-radius:12px;padding:16px;border-left:3px solid #f59e0b;display:flex;justify-content:space-between;align-items:center;transition:background 0.2s;" onmouseover="this.style.background='#334155'" onmouseout="this.style.background='#1e293b'">
        <div style="color:#e2e8f0;font-size:0.95rem;">
          <span style="color:#f59e0b;font-weight:bold;">🏆 精华推荐</span>
          <span style="margin:0 8px;color:#475569;">|</span>
          今日 {highScoreCount} 篇精华 · 最高分 {Math.max(...recommendedArticles.filter(a => a.recommendationScore >= 90).map(a => a.recommendationScore))}
        </div>
        <div style="color:#f59e0b;font-size:0.9rem;">查看全部 →</div>
      </div>
    </a>
  )}

  <div id="search-wrapper" style="position:relative;">
    <span id="search-icon" style="color:#94a3b8;font-size:1rem;">🔍</span>
    <input id="search-box" type="text" placeholder="搜索文章标题..." />
  </div>

  <div class="hide-scrollbar" style="overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none;padding-bottom:8px;margin-bottom:16px;">
    <div style="display:inline-flex;flex-wrap:nowrap;gap:8px;white-space:nowrap;">
      <button type="button" data-tag-button="全部" style="border:none;outline:none;cursor:pointer;border-radius:20px;background:#22c55e;color:#ffffff;padding:6px 14px;font-size:0.95rem;white-space:nowrap;">全部</button>
      {popularTags.map((tag: string) => (
        <button type="button" data-tag-button={tag} style="border:none;outline:none;cursor:pointer;border-radius:20px;background:#1e293b;color:#94a3b8;padding:6px 14px;font-size:0.95rem;white-space:nowrap;">{tag}</button>
      ))}
    </div>
  </div>

  {recommendedCount === 0 ? (
    <p style="color:#cbd5e1;">今日暂无高分推荐</p>
  ) : (
    <div>
      {recommendedArticles.map((article: any, index: number) => (
        <div data-article-tags={JSON.stringify(Array.isArray(article?.tags) ? article.tags : [])} data-article-title={typeof article?.title === 'string' ? article.title : ''} style="margin-bottom:16px;">
          <ArticleCard article={article} />
        </div>
      ))}
    </div>
  )}

  <script type="text/javascript">
    (function () {
      const buttons = Array.from(document.querySelectorAll('[data-tag-button]'));
      const articleCards = Array.from(document.querySelectorAll('[data-article-tags]'));
      const searchBox = document.getElementById('search-box');
      let selectedTag = '全部';
      let searchQuery = '';

      const updateVisibility = () => {
        const normalizedQuery = searchQuery.trim().toLowerCase();

        articleCards.forEach((card) => {
          const tags = JSON.parse(card.getAttribute('data-article-tags') || '[]');
          const title = (card.getAttribute('data-article-title') || '').toLowerCase();
          const matchesTag = selectedTag === '全部' || tags.includes(selectedTag);
          const matchesSearch = normalizedQuery === '' || title.includes(normalizedQuery);
          card.style.display = matchesTag && matchesSearch ? 'block' : 'none';
        });
      };

      const updateSelection = (newTag) => {
        selectedTag = newTag;
        buttons.forEach((button) => {
          const tag = button.getAttribute('data-tag-button');
          if (tag === selectedTag) {
            button.style.background = '#22c55e';
            button.style.color = '#ffffff';
          } else {
            button.style.background = '#1e293b';
            button.style.color = '#94a3b8';
          }
        });
        updateVisibility();
      };

      buttons.forEach((button) => {
        button.addEventListener('click', function () {
          updateSelection(this.getAttribute('data-tag-button'));
        });
      });

      if (searchBox) {
        searchBox.addEventListener('input', function () {
          searchQuery = this.value || '';
          updateVisibility();
        });
      }

      updateSelection('全部');

      const summaryContainer = document.getElementById('daily-summary-container');
      const summaryToggle = document.getElementById('daily-summary-toggle');

      if (summaryContainer && summaryToggle) {
        const needsToggle = summaryContainer.scrollHeight > summaryContainer.clientHeight + 1;
        if (!needsToggle) {
          summaryToggle.style.display = 'none';
        }

        summaryToggle.addEventListener('click', function () {
          const isExpanded = summaryContainer.style.maxHeight === 'none';
          summaryContainer.style.maxHeight = isExpanded ? '3.2em' : 'none';
          summaryToggle.textContent = isExpanded ? '展开全文 ▼' : '收起 ▲';
        });
      }
    })();
  </script>
</BaseLayout>
