---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

let articles: any[] = [];
let dateLabel = '今日';

try {
  const dataDir = path.join(process.cwd(), 'data');
  if (fs.existsSync(dataDir)) {
    const files = fs.readdirSync(dataDir)
      .filter((f: string) => f.startsWith('articles-') && f.endsWith('.json'))
      .sort()
      .reverse();
    if (files.length > 0) {
      const raw = fs.readFileSync(path.join(dataDir, files[0]), 'utf-8');
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) {
        articles = parsed;
      }
      dateLabel = files[0].replace('articles-', '').replace('.json', '');
    }
  }
} catch (e) {
  articles = [];
}

const sorted = articles
  .filter((a: any) => a && typeof a === 'object')
  .sort((a: any, b: any) => (b.recommendationScore || 0) - (a.recommendationScore || 0));
---

<BaseLayout title="RSS AI 评分网站">
  <h1>今日推荐 ({dateLabel})</h1>
  <p>共 {sorted.length} 篇文章</p>

  {sorted.length === 0 ? (
    <p>暂无文章数据</p>
  ) : (
    <div>
      {sorted.map((article: any) => (
        <ArticleCard article={article} />
      ))}
    </div>
  )}
</BaseLayout>
