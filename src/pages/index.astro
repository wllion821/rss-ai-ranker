---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

import fs from 'node:fs';
import path from 'node:path';

// 获取最新的文章数据
let articles = [];
let displayDate = "";

try {
	const dataDir = path.join(process.cwd(), 'data');
	if (fs.existsSync(dataDir)) {
		const files = fs.readdirSync(dataDir)
			.filter(f => f.startsWith('articles-') && f.endsWith('.json'))
			.sort()
			.reverse();
		
		if (files.length > 0) {
			const latestFile = files[0];
			displayDate = latestFile.replace('articles-', '').replace('.json', '');
			const filePath = path.join(dataDir, latestFile);
			const content = fs.readFileSync(filePath, 'utf-8');
			articles = JSON.parse(content);
			if (!Array.isArray(articles)) articles = [];
		}
	}
} catch (e) {
	console.error("Error loading articles:", e);
	articles = [];
}

// 按得分排序
const sortedArticles = articles.length > 0 
	? [...articles].sort((a, b) => b.recommendationScore - a.recommendationScore) 
	: [];
---

<BaseLayout title="今日推荐">
	<div class="mb-8">
		<h1 class="text-3xl font-extrabold text-gray-900 mb-2">今日 AI 强推</h1>
		<p class="text-gray-500">{displayDate || "今日"} · 自动扫描 100+ 科技源，AI 深度评分</p>
	</div>

	{sortedArticles.length > 0 ? (
		<div class="grid gap-6">
			{sortedArticles.map(article => (
				<ArticleCard article={article} />
			))}
		</div>
	) : (
		<div class="py-20 text-center text-gray-500">
			<p class="text-xl">暂无今日推荐文章</p>
			<p class="mt-2">请稍后再来查看</p>
		</div>
	)}
</BaseLayout>
