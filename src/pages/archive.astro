---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

let archiveDates: string[] = [];

try {
  const dataDir = path.join(process.cwd(), 'data');
  if (fs.existsSync(dataDir)) {
    const files = fs.readdirSync(dataDir)
      .filter((f: string) => f.startsWith('articles-') && f.endsWith('.json'))
      .sort()
      .reverse();
    archiveDates = files.map(f => f.replace('articles-', '').replace('.json', ''));
  }
} catch (e) {
  archiveDates = [];
}
---

<BaseLayout title="历史归档">
  <style>
    .archive-title { font-size: 2rem; font-weight: 700; color: #ffffff; margin: 0 0 8px; }
    .archive-desc { color: #cbd5e1; margin: 0 0 32px; }
    .archive-card { background: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); padding: 24px; }
    .date-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
    .date-item { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; text-align: center; transition: all 0.2s; }
    .date-item:hover { background: #f1f5f9; border-color: #22d3ee; }
    .date-link { color: #334155; text-decoration: none; font-weight: 500; display: block; }
    .date-link:hover { color: #22d3ee; }
    .date-count { color: #64748b; font-size: 0.9rem; margin-top: 4px; }
    @media (max-width: 640px) {
      .archive-title { font-size: 1.4rem; }
      .date-list { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
    }
  </style>

  <h1 class="archive-title">📚 历史归档</h1>
  <p class="archive-desc">按日期查看过去的推荐文章</p>

  <div class="archive-card">
    {archiveDates.length === 0 ? (
      <p style="color:#64748b;margin:0;">暂无历史数据</p>
    ) : (
      <div class="date-list">
        {archiveDates.map((date: string) => {
          let articleCount = 0;
          try {
            const dataDir = path.join(process.cwd(), 'data');
            const filePath = path.join(dataDir, `articles-${date}.json`);
            if (fs.existsSync(filePath)) {
              const raw = fs.readFileSync(filePath, 'utf-8');
              const parsed = JSON.parse(raw);
              const articles = parsed.articles || parsed;
              articleCount = Array.isArray(articles) ? articles.length : 0;
            }
          } catch (e) {
            articleCount = 0;
          }
          return (
            <div class="date-item">
              <a class="date-link" href={`/rss-ai-ranker/day/${date}`}>
                {date}
              </a>
              <div class="date-count">{articleCount} 篇文章</div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>
