---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

interface Article {
  id: string;
  title: string;
  link: string;
  source: string;
  publishedAt: string;
  summary: string;
  recommendationScore: number;
  comment?: string;
  tags?: string[];
  [key: string]: any;
}

interface DayGroup {
  date: string;
  articles: Article[];
  maxScore: number;
}

interface MonthGroup {
  month: string; // YYYY-MM
  days: DayGroup[];
}

let monthGroups: MonthGroup[] = [];
let totalHighlights = 0;
let totalScore = 0;

try {
  const dataDir = path.join(process.cwd(), 'data');
  if (fs.existsSync(dataDir)) {
    const files = fs.readdirSync(dataDir)
      .filter((f: string) => f.startsWith('articles-') && f.endsWith('.json'))
      .sort()
      .reverse();

    const tempMap: Record<string, Record<string, Article[]>> = {};

    for (const file of files) {
      const date = file.replace('articles-', '').replace('.json', '');
      const month = date.substring(0, 7);
      const raw = fs.readFileSync(path.join(dataDir, file), 'utf-8');
      const parsed = JSON.parse(raw);
      
      let dayArticles: Article[] = [];
      if (parsed.articles && Array.isArray(parsed.articles)) {
        dayArticles = parsed.articles;
      } else if (Array.isArray(parsed)) {
        dayArticles = parsed;
      }

      const filtered = dayArticles.filter((a: Article) => (a.recommendationScore || 0) >= 90);
      
      if (filtered.length > 0) {
        if (!tempMap[month]) tempMap[month] = {};
        tempMap[month][date] = filtered.sort((a, b) => (b.recommendationScore || 0) - (a.recommendationScore || 0));
        
        totalHighlights += filtered.length;
        totalScore += filtered.reduce((sum, a) => sum + (a.recommendationScore || 0), 0);
      }
    }

    // Convert tempMap to sorted monthGroups
    const sortedMonths = Object.keys(tempMap).sort().reverse();
    for (const month of sortedMonths) {
      const days: DayGroup[] = [];
      const sortedDays = Object.keys(tempMap[month]).sort().reverse();
      for (const date of sortedDays) {
        const articles = tempMap[month][date];
        const maxScore = Math.max(...articles.map(a => a.recommendationScore || 0));
        days.push({ date, articles, maxScore });
      }
      monthGroups.push({ month, days });
    }
  }
} catch (e) {
  console.error('Error loading highlights:', e);
}

const averageHighlightScore = totalHighlights > 0 
  ? (totalScore / totalHighlights).toFixed(1) 
  : '0';

const months = monthGroups.map(m => m.month);
---

<BaseLayout title="精华推荐">
  <div style="margin-bottom: 24px;">
    <h1 style="margin: 0 0 8px; font-size: 2rem; color: #ffffff;">🏆 精华推荐</h1>
    <p style="margin: 0; color: #94a3b8; font-size: 1rem;">
      收录所有推荐分 ≥ 90 的精品内容
    </p>
  </div>

  <div style="display: flex; gap: 12px; margin-bottom: 32px;">
    <div style="background: #1e293b; border-radius: 8px; padding: 16px; flex: 1; border-left: 4px solid #f59e0b;">
      <p style="font-size: 12px; color: #94a3b8; margin: 0 0 4px;">累计精华数</p>
      <p style="font-size: 24px; font-weight: 700; color: #ffffff; margin: 0;">{totalHighlights}</p>
    </div>
    <div style="background: #1e293b; border-radius: 8px; padding: 16px; flex: 1; border-left: 4px solid #22d3ee;">
      <p style="font-size: 12px; color: #94a3b8; margin: 0 0 4px;">平均精华分</p>
      <p style="font-size: 24px; font-weight: 700; color: #ffffff; margin: 0;">{averageHighlightScore}</p>
    </div>
  </div>

  {monthGroups.length === 0 ? (
    <div style="text-align: center; padding: 48px 0; color: #94a3b8;">
      <p style="font-size: 1.2rem;">暂无精华推荐</p>
    </div>
  ) : (
    <>
      {/* Month Tabs */}
      <div class="hide-scrollbar" style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 16px; margin-bottom: 24px; scrollbar-width: none; -ms-overflow-style: none;">
        {months.map((month, index) => (
          <button 
            type="button"
            data-month-tab={month}
            style={`border:none; outline:none; cursor:pointer; border-radius:20px; padding:8px 16px; font-size:0.95rem; white-space:nowrap; transition:all 0.2s; ${index === 0 ? 'background:#f59e0b; color:#000;' : 'background:#1e293b; color:#94a3b8;'}`}
          >
            {month}
          </button>
        ))}
      </div>

      {/* Month Content Containers */}
      {monthGroups.map((monthGroup, mIndex) => (
        <div 
          data-month-content={monthGroup.month} 
          style={`display: ${mIndex === 0 ? 'block' : 'none'};`}
        >
          {monthGroup.days.length === 0 ? (
            <p style="text-align: center; padding: 32px 0; color: #94a3b8;">该月暂无精华推荐</p>
          ) : (
            monthGroup.days.map((dayGroup, dIndex) => (
              <div style="margin-bottom: 8px;">
                {/* Accordion Header */}
                <div 
                  data-accordion-header
                  style="background:#1e293b; border-radius:8px; padding:12px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; user-select:none; transition:background 0.2s;"
                  onmouseover="this.style.background='#334155'"
                  onmouseout="this.style.background='#1e293b'"
                >
                  <div style="display:flex; align-items:center; gap:12px;">
                    <span style="color:#ffffff; font-weight:700; font-size:1rem;">{dayGroup.date}</span>
                    <span style="background:rgba(245, 158, 11, 0.1); color:#f59e0b; padding:2px 8px; border-radius:4px; font-size:12px;">{dayGroup.articles.length} 篇</span>
                    <span style="color:#64748b; font-size:12px;">最高分 {dayGroup.maxScore}</span>
                  </div>
                  <span data-accordion-icon style={`color:#64748b; font-size:12px; transition:transform 0.3s; ${mIndex === 0 && dIndex === 0 ? 'transform:rotate(180deg);' : ''}`}>▼</span>
                </div>

                {/* Accordion Content */}
                <div 
                  data-accordion-content
                  style={`overflow:hidden; transition:max-height 0.3s ease-out; padding-top: 8px; ${mIndex === 0 && dIndex === 0 ? 'max-height: 5000px;' : 'max-height: 0;'}`}
                >
                  <div style="padding: 4px 0 8px;">
                    {dayGroup.articles.map((article) => (
                      <div style="margin-bottom: 12px; border-left: 3px solid #f59e0b; border-radius: 12px;">
                        <ArticleCard article={article} />
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))
          )}
        </div>
      ))}
    </>
  )}

  <script type="text/javascript">
    (function () {
      const tabs = Array.from(document.querySelectorAll('[data-month-tab]'));
      const contents = Array.from(document.querySelectorAll('[data-month-content]'));
      const accordionHeaders = Array.from(document.querySelectorAll('[data-accordion-header]'));

      // Month Tab Switching
      tabs.forEach((tab) => {
        tab.addEventListener('click', function () {
          const selectedMonth = this.getAttribute('data-month-tab');
          
          // Update Tab Styles
          tabs.forEach(t => {
            if (t === this) {
              t.style.background = '#f59e0b';
              t.style.color = '#000';
            } else {
              t.style.background = '#1e293b';
              t.style.color = '#94a3b8';
            }
          });

          // Show/Hide Content
          contents.forEach(c => {
            c.style.display = c.getAttribute('data-month-content') === selectedMonth ? 'block' : 'none';
          });
        });
      });

      // Accordion Functionality
      accordionHeaders.forEach((header) => {
        header.addEventListener('click', function () {
          const content = this.nextElementSibling;
          const icon = this.querySelector('[data-accordion-icon]');
          
          const isExpanded = content.style.maxHeight !== '0px' && content.style.maxHeight !== '';
          
          if (isExpanded) {
            content.style.maxHeight = '0px';
            icon.style.transform = 'rotate(0deg)';
          } else {
            // Expand
            content.style.maxHeight = '5000px'; // Larger than any likely content
            icon.style.transform = 'rotate(180deg)';
          }
        });
      });
    })();
  </script>
</BaseLayout>
